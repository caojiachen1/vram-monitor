{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vram-monitor",
  "version": "0.1.0",
  "identifier": "com.vram-monitor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "系统资源监控",
        "width": 420,
        "height": 240,
        "minWidth": 280,
        "minHeight": 110,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
