{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vram-monitor",
  "version": "0.1.0",
  "identifier": "com.vram-monitor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GPU 显存监控",
        "width": 380,
        "height": 240,
        "minWidth": 280,
        "minHeight": 180,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
